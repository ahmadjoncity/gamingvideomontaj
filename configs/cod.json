{
  "name": "Call of Duty / Warzone",
  "game": "cod",
  "description": "Fast TTK shooter: very audio-heavy, quick cuts, glitchy transitions, aggressive look.",
  "detection": {
    "weights": { "audio": 0.5, "motion": 0.22, "flash": 0.15, "text": 0.13 },
    "min_score": 0.5,
    "window_seconds": 2.0,
    "pad_before": 1.2,
    "pad_after": 1.0,
    "merge_gap": 1.0,
    "keywords": ["killed", "headshot", "kill streak", "nuke", "victory", "down", "longshot"]
  },
  "montage": {
    "target_highlights": 14,
    "min_highlights": 8,
    "max_highlights": 15,
    "slowmo_on_peak": true,
    "punch_zoom": true,
    "shake": true,
    "transition": "glitch",
    "build_to_peak": true,
    "beat_sync": true
  },
  "style": {
    "color_grade": "hdr",
    "caption_color": "#FFFFFF",
    "caption_highlight": "#9BE800",
    "caption_outline": "#000000",
    "overlay_color": "#9BE800",
    "intro_text": ""
  },
  "overlays": {
    "kill": "DOWN",
    "clutch": "1vX",
    "epic": "INSANE",
    "action": "CRACKED",
    "ace": "NUKE INCOMING"
  }
}
